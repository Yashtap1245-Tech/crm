# Copy into your secret manager or shell environment. Never commit real values.
DEBUG=false
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
DATABASE_URL=postgresql://crm_runtime:REPLACE@HOST:5432/CRM?sslmode=require
# Migration/backup owner credentials are separate and never passed to the web process.
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=
ALLOWED_HOSTS=YOUR-SERVICE.onrender.com
CSRF_TRUSTED_ORIGINS=https://YOUR-SERVICE.onrender.com
PUBLIC_URL=https://YOUR-SERVICE.onrender.com
TRUST_PROXY=true
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Folio <accounts@YOUR-VERIFIED-DOMAIN>
PILOT_COMPANY_LIMIT=3
WORKSPACE_RECORD_LIMIT=1000
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FILE_SCAN_COMMAND=/usr/bin/clamscan
BACKUP_ENCRYPTION_KEY=
# PG_DUMP is the path to a pg_dump executable matching the server major version.
PG_DUMP=pg_dump
